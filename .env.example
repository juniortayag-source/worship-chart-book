
# Postgres connection string. Works with any provider: Neon, Supabase,
# Railway, Vercel's own Postgres marketplace integration, etc.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Vercel Blob storage token, for the rendered chord-chart page images (the
# original PDFs are never stored). When you add Blob storage to this project
# in the Vercel dashboard (Storage tab), Vercel sets this automatically for
# deployed environments. For local development with `vercel dev`, run
# `vercel env pull` to copy it (and DATABASE_URL) into this file.
BLOB_READ_WRITE_TOKEN=

# Password required to open the app at all (checked by middleware.js via
# HTTP Basic Auth — your browser will prompt for it). Any username works;
# only the password matters. Leave blank to leave the app unprotected.
APP_PASSWORD=

# Optional second, view-only password. Anyone who logs in with this one can
# look at everything (songs, charts, Sunday logs) but can't add, edit,
# delete, or tag anything — those actions are blocked both in the UI and by
# the API itself. Leave blank to skip having a view-only option.
APP_VIEW_PASSWORD=
