
# Postgres connection string. Works with any provider: Neon, Supabase,
# Railway, Vercel's own Postgres marketplace integration, etc.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Vercel Blob storage token, for the rendered chord-chart page images (the
# original PDFs are never stored). When you add Blob storage to this project
# in the Vercel dashboard (Storage tab), Vercel sets this automatically for
# deployed environments. For local development with `vercel dev`, run
# `vercel env pull` to copy it (and DATABASE_URL) into this file.
BLOB_READ_WRITE_TOKEN=

# The whole app now sits behind a login screen — there's no public/view-only
# access anymore, and every account that can log in can edit everything. The
# eleven accounts (Junior, Kris, Katreena, Liezl, Kevin, Cristian, David,
# Jayronn, Kirsten, Janine, Brian) and their passwords are built into
# api/_auth.js by default, so this works with nothing set here. To change a
# name or password without editing code (and without it sitting in your git
# history), set APP_USERS to a JSON array in this shape instead — it
# overrides the built-in list (also update the <option> list in index.html's
# login screen if you add or rename someone this way):
# APP_USERS=[{"id":"junior","name":"Junior","password":"MFBCworshipteam!!"},{"id":"kris","name":"Kris","password":"MFBCworshipteam!!"},{"id":"katrina","name":"Katreena","password":"MFBCworshipteam!!"},{"id":"liezl","name":"Liezl","password":"MFBCworshipteam!!"},{"id":"kevin","name":"Kevin","password":"MFBCworshipteam!!"},{"id":"cristian","name":"Cristian","password":"MFBCworshipteam!!"},{"id":"david","name":"David","password":"MFBCworshipteam!!"},{"id":"jayronn","name":"Jayronn","password":"MFBCworshipteam!!"},{"id":"kirsten","name":"Kirsten","password":"MFBCworshipteam!!"},{"id":"janine","name":"Janine","password":"MFBCworshipteam!!"},{"id":"brian","name":"Brian","password":"MFBCworshipteam!!"}]
APP_USERS=
