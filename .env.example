
# Postgres connection string. Works with any provider: Neon, Supabase,
# Railway, Vercel's own Postgres marketplace integration, etc.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Vercel Blob storage token, for the rendered chord-chart page images (the
# original PDFs are never stored). When you add Blob storage to this project
# in the Vercel dashboard (Storage tab), Vercel sets this automatically for
# deployed environments. For local development with `vercel dev`, run
# `vercel env pull` to copy it (and DATABASE_URL) into this file.
BLOB_READ_WRITE_TOKEN=
